# Copia este archivo con el nombre .env y completa tus datos (el archivo .env no se sube al repositorio).
# En PowerShell: Copy-Item .env.example .env

# Base de datos PostgreSQL
POSTGRES_DB=axztra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=escribe-aqui-la-clave-que-elegiste-al-instalar-postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Opcional: pedir el código de verificación solo al equipo (1 = también a los clientes)
# AXZTRA_VERIFICACION_CLIENTES=1
